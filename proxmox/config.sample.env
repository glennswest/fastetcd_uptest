# Copy to proxmox/config.env (which is .gitignore'd) and fill in.
#
# All values here are typical defaults for a g8.lo Proxmox install.
# Adjust to your environment.

# Proxmox host reachable from this workstation. Includes the API
# port (default 8006). HTTPS required.
PROXMOX_HOST=pvex.g8.lo:8006

# API token in the form `USER@REALM!TOKENID=SECRET`. Create at:
#   Datacenter → Permissions → API Tokens
PROXMOX_TOKEN='root@pam!uptest=00000000-0000-0000-0000-000000000000'

# Node name within the Proxmox cluster the VMs land on.
PROXMOX_NODE=pvex

# Storage pool that holds the cloud image template + new VM disks.
PROXMOX_STORAGE=local-lvm

# Network bridge the VMs attach to. Must route to your client
# machine so we can hit kube-apiserver during measurements.
PROXMOX_BRIDGE=vmbr0

# VMID of the Ubuntu 24.04 cloud-init template Proxmox should clone.
# (Create with: qm create + qm importdisk + qm set --ide2 ...
#  --serial0 socket --boot c --bootdisk ...; then `qm template`.)
UBUNTU_TEMPLATE_VMID=9000

# VMID range for variant VMs. The harness picks unused IDs from
# this range so two parallel runs don't collide.
VMID_RANGE_START=110
VMID_RANGE_END=119

# Kubernetes version (Linux package version string; e.g. 1.31.4-1.1).
K8S_VERSION=1.31.4-1.1
K8S_MINOR=1.31

# fastetcd container image used by variant B.
FASTETCD_IMAGE=ghcr.io/glennswest/fastetcd:latest

# Pod / service CIDRs. Defaults match kubeadm's defaults.
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12
